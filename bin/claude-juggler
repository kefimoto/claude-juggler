#!/usr/bin/env bash
# Resolve the actual directory of this script, handling symlinks
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  [[ $SCRIPT != /* ]] && SCRIPT="$DIR/$SCRIPT"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")/.." && pwd)"

if [ -f "$SCRIPT_DIR/src/cli.ts" ] && command -v bun &>/dev/null; then
  exec bun "$SCRIPT_DIR/src/cli.ts" "$@"
else
  exec node "$SCRIPT_DIR/dist/cli.js" "$@"
fi
